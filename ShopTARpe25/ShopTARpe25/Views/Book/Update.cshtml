@model ShopTARpe25.Models.Book.UpdateBookTitleViewModel

<h1>Update Title</h1>
<br />
<div>
    <form method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />

        <div class="form-group d-flex align-items-center gap-3">
            <label asp-for="Title" class="mb-0">
                <h2 class="mb-0">Title:</h2>
            </label>

            <input asp-for="Title" class="form-control" />
        </div>

        <br />
        <div>
            <input asp-action="Update" asp-controller="Book"
                   type="submit" class="btn btn-sm btn-outline-primary rounded-3" value="Update" />
            <a asp-action="Index" asp-controller="Book"
               class="btn btn-sm btn-outline-primary rounded-3">Back to list</a>
        </div>
    </form>
</div>
