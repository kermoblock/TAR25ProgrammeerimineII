@model ShopTARpe25.Models.Library.BookCreateViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="text-center mb-4">
                <h1 class="fw-bold">Add a New Book</h1>
                <p class="text-muted">Add a book to your library collection.</p>
            </div>

            <div class="card border-0 shadow rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h5 class="mb-1 fw-bold">Book Information</h5>
                    <small>Enter the details of the book below.</small>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" asp-controller="Book" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold">Book Title</label>
                            <input asp-for="Title" class="form-control form-control-lg rounded-3"
                                   placeholder="Enter book title" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Author" class="form-label fw-semibold">Author</label>
                            <input asp-for="Author" class="form-control form-control-lg rounded-3"
                                   placeholder="Enter author name" />
                            <span asp-validation-for="Author" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PublishedYear" class="form-label fw-semibold">Published Year</label>
                            <input asp-for="PublishedYear" type="number"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="e.g. 2020" />
                            <span asp-validation-for="PublishedYear" class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mt-5">
                            <a asp-action="Index" asp-controller="Book"
                                   class="btn btn-outline-secondary btn-lg rounded-3">
                                ← Back to Library
                            </a>

                            <button type="submit" class="btn btn-primary btn-lg rounded-3 px-4">
                                + Add Book
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>