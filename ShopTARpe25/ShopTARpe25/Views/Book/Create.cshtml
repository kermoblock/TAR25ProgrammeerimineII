@model ShopTARpe25.Models.Library.BookCreateViewModel

<div>
    <div >
        <div class="col-lg-7">
            <div>
                <h1 class="fw-bold">Add a new book</h1>
            </div>
            <br />

            <div>
                <div>
                    <form asp-action="Create" asp-controller="Book" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold">Book Title:</label>
                            <input asp-for="Title" class="form-control form-control-lg rounded-3" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Author" class="form-label fw-semibold">Author: </label>
                            <input asp-for="Author" class="form-control form-control-lg rounded-3" />
                            <span asp-validation-for="Author" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PublishedYear" class="form-label fw-semibold">Published Year: </label>
                            <input asp-for="PublishedYear" class="form-control form-control-lg rounded-3" />
                            <span asp-validation-for="PublishedYear" class="text-danger"></span>
                        </div>

                        <div>
                            <a asp-action="Index" asp-controller="Book" class="btn btn-outline-primary">
                                Back to Library
                            </a>

                            <button type="submit" class="btn btn-outline-primary">
                                Add Book
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>