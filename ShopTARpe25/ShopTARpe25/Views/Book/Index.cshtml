@model IEnumerable<ShopTARpe25.Models.Library.BookIndexViewModel>

@{
    int rowNumber = 1;
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5">
        <div>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-2">
                LIBRARY MANAGEMENT
            </span>
            <h1 class="display-5 fw-bold mb-2">My Library</h1>
            <p class="text-muted mb-0">Manage your books and track their availability.</p>
        </div>

        <a asp-action="Create" asp-controller="Book"
               class="btn btn-primary btn-lg rounded-3 shadow-sm px-4">
            + Add New Book
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle rounded-3 p-3 fs-3">📚</div>
                    <div>
                        <p class="text-muted mb-1">Total Books</p>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-success-subtle rounded-3 p-3 fs-3">✓</div>
                    <div>
                        <p class="text-muted mb-1">Available Books</p>
                        <h3 class="fw-bold mb-0">
                            @Model.Count(book => book.IsAvailable)
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-1">Book Collection</h5>
            <p class="text-muted small mb-0">All books registered in the library.</p>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3">#</th>
                        <th class="py-3">Title</th>
                        <th class="py-3">Author</th>
                        <th class="py-3">Published Year</th>
                        <th class="py-3">Availability</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var book in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-dark rounded-pill">
                                        @rowNumber
                                    </span>
                                </td>

                                <td class="fw-semibold">@book.Title</td>
                                <td>@book.Author</td>
                                <td>@book.PublishedYear</td>

                                <td>
                                    @if (book.IsAvailable)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            Borrowed
                                        </span>
                                    }
                                </td>
                            </tr>

                            rowNumber++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="display-4 mb-3">📖</div>
                                <h5 class="fw-bold">Your library is empty</h5>
                                <p class="text-muted">Add your first book to get started.</p>
                                <a asp-action="Create" asp-controller="Book"
                                       class="btn btn-primary rounded-3">
                                    + Add Your First Book
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-0 p-4">
            <span class="text-muted small">
                Showing @Model.Count() book(s)
            </span>
        </div>
    </div>
</div>