@model IEnumerable<ShopTARpe25.Models.Library.BookIndexViewModel>

@{
    int rowNumber = 1;
}

<form asp-controller="Book" asp-action="Index" method="get" class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3">Search Books</h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Publication Year</label>
                <input type="number" name="year" value="@ViewBag.Year"
                       class="form-control rounded-3" placeholder="e.g. 2000" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Book Title</label>
                <input type="text" name="title" value="@ViewBag.TitleSearch"
                       class="form-control rounded-3" placeholder="Exact title" />
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input type="checkbox" name="borrowedOnly" value="true"
                           class="form-check-input" id="borrowedOnly"
                           checked="@(ViewBag.BorrowedOnly == true)" />
                    <label class="form-check-label" for="borrowedOnly">
                        Currently borrowed only
                    </label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary rounded-3">Search</button>
            <a asp-controller="Book" asp-action="Index"
               class="btn btn-outline-secondary rounded-3">Clear</a>
        </div>
    </div>
</form>

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5">
        <div>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-2">
                LIBRARY MANAGEMENT
            </span>
            <h1 class="display-5 fw-bold mb-2">My Library</h1>
            <p class="text-muted mb-0">
                Manage your books and track their availability.
            </p>
        </div>

        <a asp-action="Create"
               asp-controller="Book"
               class="btn btn-primary btn-lg rounded-3 shadow-sm px-4">
            + Add New Book
        </a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle rounded-3 p-3 fs-3">📚</div>
                    <div>
                        <p class="text-muted mb-1">Total Books</p>
                        <h3 class="fw-bold mb-0">@Model.Count()</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-success-subtle rounded-3 p-3 fs-3">✓</div>
                    <div>
                        <p class="text-muted mb-1">Available Books</p>
                        <h3 class="fw-bold mb-0">
                            @Model.Count(book => book.IsAvailable)
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-1">Book Collection</h5>
            <p class="text-muted small mb-0">
                All books registered in the library.
            </p>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3">#</th>
                        <th class="py-3">Title</th>
                        <th class="py-3">Author</th>
                        <th class="py-3">Published Year</th>
                        <th class="py-3">Availability</th>
                        <th class="py-3 text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var book in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-dark rounded-pill">
                                        @rowNumber
                                    </span>
                                </td>

                                <td class="fw-semibold">@book.Title</td>

                                <td>@book.Author</td>

                                <td>@book.PublishedYear</td>

                                <td>
                                    @if (book.IsAvailable)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            Borrowed
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                                        <a asp-action="Update"
                                               asp-controller="Book"
                                               asp-route-id="@book.Id"
                                               class="btn btn-sm btn-outline-primary rounded-2">
                                            Update book title
                                        </a>

                                        <a asp-action="Delete"
                                               asp-controller="Book"
                                               asp-route-id="@book.Id"
                                               class="btn btn-sm btn-outline-danger rounded-2">
                                            Delete
                                        </a>

                                    </div>
                                </td>
                            </tr>

                            rowNumber++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="display-4 mb-3"></div>
                                <h5 class="fw-bold">Your library is empty</h5>
                                <p class="text-muted mb-0">
                                    Click "+ Add New Book" above to get started.
                                </p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-0 p-4">
            <span class="text-muted small">
                Showing @Model.Count() book(s)
            </span>
        </div>
    </div>
</div>