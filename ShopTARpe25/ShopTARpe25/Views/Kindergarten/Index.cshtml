@model IEnumerable<ShopTARpe25.Models.Spaceship.SpaceshipIndexViewModel>

@{
    int rownumber = 1;
}
<div>
    <a asp-action="create" asp-controller="Spaceship" type="submit" class="btn btn-primary">Create</a>
</div>

<div class="h1">
    Spaceship
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Built Date</th>
                <th scope="col">Crew</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
            {
                <tr>
                    <td>@rownumber</td>
                    <td>@spaceship.Name</td>
                    <td>@spaceship.Classification</td>
                    <td>@spaceship.BuiltDate</td>
                    <td>@spaceship.Crew</td>
                    <td>
                        <a asp-action="Details" asp-controller="Spaceship" asp-route-id="@spaceship.Id" type="submit" class="btn btn-outline-info">Details</a>
                        <a asp-action="Update" asp-controller="Spaceship" asp-route-id="@spaceship.Id" type="submit" class="btn btn-outline-success">Update</a>
                        <a asp-action="Delete" asp-controller="Spaceship" asp-route-id="@spaceship.Id" type="submit" class="btn btn-outline-danger">Delete</a>

                    </td>
                </tr>
                    rownumber++;
                }
        </tbody>
    </table>
</form>