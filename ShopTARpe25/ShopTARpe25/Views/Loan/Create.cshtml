@model ShopTARpe25.Models.Loan.LoanCreateViewModel

@{
    ViewData["Title"] = "New Loan";
}

<div>
    <div class="mb-4">
        <h1 class="display-5 fw-bold mb-2">New Loan</h1>
    </div>

        <div>
            <form asp-controller="Loan" asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div>
                    <label asp-for="BookId">Book</label>
                    <select asp-for="BookId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Books, "Id", "Title"))">
                        <option value="">-- Select a book --</option>
                    </select>
                </div>
                <br />

                <div>
                    <label asp-for="ReaderId">Reader</label>
                    <select asp-for="ReaderId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Readers, "Id", "FullName"))">
                        <option value="">-- Select a reader --</option>
                    </select>
                </div>
                <br />

                <div>
                    <label asp-for="LoanDate" class="form-label fw-semibold">Loan Date</label>
                    <input asp-for="LoanDate" type="datetime-local" class="form-control form-control-lg rounded-3" readonly />
                    <span asp-validation-for="LoanDate" class="text-danger"></span>
                </div>
                <br />

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary btn-lg rounded-3">
                        Create Loan
                    </button>
                    <a asp-controller="Loan" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-3">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

