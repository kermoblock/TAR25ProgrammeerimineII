@model ShopTARpe25.Models.Loan.LoanReturnViewModel

@{
    ViewData["Title"] = "Return Book";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="display-5 fw-bold mb-2">Return Book</h1>
    </div>

    <div>
        <div>
            <h5 class="fw-bold mb-1">Loan Information</h5>
        </div>
        <br />

        <div>
            <div>
                <div class="col-md-6">
                    <div>
                        <h4>Book Title</h4>
                        <h6 class="fw-semibold mb-0">@Model.Title</h6>
                    </div>
                </div>
                <br />

                <div class="col-md-6">
                    <div>
                        <h4>Reader Full Name</h4>
                        <h6 class="fw-semibold mb-0">@Model.FullName</h6>
                    </div>
                </div>
                <br />

                <div class="col-md-6">
                    <div>
                        <h4>Loan Date</h4>
                        <h6 class="fw-semibold mb-0">
                            @Model.LoanDate.ToString("dd.MM.yyyy HH:mm")
                        </h6>
                    </div>
                </div>
                <br />

                <div class="col-md-6">
                    <div>
                        <h4>Return Date</h4>
                        <h6 class="fw-semibold mb-0">
                            @(Model.ReturnDate?.ToString("dd.MM.yyyy HH:mm") ?? "Not returned")
                        </h6>
                    </div>
                </div>
            </div>
            <br />

            <form asp-controller="Loan"
                  asp-action="Return"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button type="submit"
                            class="btn btn-success btn-lg rounded-3 px-4">
                        Confirm Return
                    </button>

                    <a asp-controller="Loan"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
