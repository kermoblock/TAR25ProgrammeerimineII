@model IEnumerable<ShopTARpe25.Models.Loan.LoanIndexViewModel>

@{
    int rowNumber = 1;
}

<div class="container py-5">
    <div>
        <h1 class="display-5 fw-bold mb-2">Book Loans</h1>
    </div>
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5">

        <a asp-action="Create"
           asp-controller="Loan"
           class="btn btn-primary btn-lg rounded-3 shadow-sm px-4 text-nowrap d-flex align-items-center justify-content-center"
           style="min-width: 160px;">
            New Loan
        </a>

        <div class="col-md-6">
            <div class="card-body p-4">
                <p class="text-muted mb-1">Total Loans</p>
                <h3 class="fw-bold mb-0">@Model.Count()</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-body p-4">
                <p class="text-muted mb-1">Currently Borrowed</p>
                <h3 class="fw-bold mb-0">@Model.Count(loan => loan.ReturnDate == null)</h3>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div>
            <h5 class="fw-bold mb-1">  Loan Records</h5>
        </div>    
        <br />

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3">#</th>
                        <th class="py-3">Book</th>
                        <th class="py-3">Reader</th>
                        <th class="py-3">Loan Date</th>
                        <th class="py-3">Return Date</th>
                        <th class="py-3">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var loan in Model)
                        {
                            <tr>
                                <td class="ps-4">@rowNumber</td>
                                <td>@loan.Title</td>
                                <td>@loan.FullName</td>
                                <td>@loan.LoanDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@(loan.ReturnDate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                <td>
                                    @if (loan.ReturnDate == null)
                                    {
                                        <span class="badge bg-warning">
                                            Borrowed
                                        </span>

                                        @if (loan.ReturnDate == null)
                                        {
                                            <a asp-action="Return"
                                               asp-controller="Loan"
                                               asp-route-id="@loan.Id"
                                               class="btn btn-primary btn-sm rounded-3 px-3 ms-2">
                                                Return the book
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Returned
                                        </span>
                                    }
                                </td>
                            </tr>
                            rowNumber++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <h5 class="fw-bold">No loans yet</h5>
                                <p class="text-muted mb-0">Click "New Loan" to get started.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
