@model IEnumerable<ShopTARpe25.Models.Loan.LoanIndexViewModel>

@{
    int rowNumber = 1;
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5">
        <div>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-2">LIBRARY MANAGEMENT</span>
            <h1 class="display-5 fw-bold mb-2">Book Loans</h1>
            <p class="text-muted mb-0">Track borrowed books and their return dates.</p>
        </div>
        <a asp-action="Create" asp-controller="Loan" class="btn btn-primary btn-lg rounded-3 shadow-sm px-4">
            + New Loan
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">Total Loans</p>
                    <h3 class="fw-bold mb-0">@Model.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">Currently Borrowed</p>
                    <h3 class="fw-bold mb-0">@Model.Count(loan => loan.ReturnDate == null)</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-1">Loan Records</h5>
            <p class="text-muted small mb-0">All registered book loans.</p>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3">#</th>
                        <th class="py-3">Book</th>
                        <th class="py-3">Reader</th>
                        <th class="py-3">Loan Date</th>
                        <th class="py-3">Return Date</th>
                        <th class="py-3">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var loan in Model)
                        {
                            <tr>
                                <td class="ps-4">@rowNumber</td>
                                <td>@loan.BookId</td>
                                <td>@loan.ReaderId</td>
                                <td>@loan.LoanDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@(loan.ReturnDate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                <td>
                                    @if (loan.ReturnDate == null)
                                    {
                                        <span class="badge bg-warning-subtle text-dark rounded-pill px-3 py-2">Borrowed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">Returned</span>
                                    }
                                </td>
                            </tr>
                            rowNumber++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <h5 class="fw-bold">No loans yet</h5>
                                <p class="text-muted mb-0">Click "+ New Loan" to register a loan.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-0 p-4">
            <span class="text-muted small">Showing @Model.Count() loan(s)</span>
        </div>
    </div>
</div>
