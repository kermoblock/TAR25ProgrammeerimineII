@model IEnumerable<ShopTARpe25.Models.Spaceship.SpaceshipIndexViewModel>
<div>
    <a asp-action="create" asp-controller="Spaceship" type="submit" class="btn btn-primary">Create</a>
</div>

<h2>Spaceships</h2>
<div>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Classification)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BuiltDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Crew)
                </th>
            </tr>
        </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Classification)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BuiltDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Crew)
            </td>
            <td>
                <a asp-action="Update" asp-route-id="@item.Id">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>
</div>