@model ShopTARpe25.Models.Reader.ReaderCreateViewModel

@{
    ViewData["Title"] = "New Reader";
}

<div class="container py-5">
    <div class="mb-4">
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-2">LIBRARY MANAGEMENT</span>
        <h1 class="display-5 fw-bold mb-2">New Reader</h1>
        <p class="text-muted">Register a new library reader.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <form asp-controller="Reader" asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                    <input asp-for="FullName" class="form-control form-control-lg rounded-3" placeholder="Enter full name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" type="email" class="form-control form-control-lg rounded-3" placeholder="Enter email address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary btn-lg rounded-3 px-4">
                        Create Reader
                    </button>

                    <a asp-controller="Reader" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
