@model IEnumerable<ShopTARpe25.Models.Reader.ReaderIndexViewModel>

@{
    int rowNumber = 1;
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5">
        <div>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-2">LIBRARY MANAGEMENT</span>
            <h1 class="display-5 fw-bold mb-2">Readers</h1>
            <p class="text-muted mb-0">Manage registered library readers.</p>
        </div>

        <a asp-action="Create" asp-controller="Reader" class="btn btn-primary btn-lg rounded-3 shadow-sm px-4">
            + New Reader
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">Total Readers</p>
                    <h3 class="fw-bold mb-0">@Model.Count()</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-1">Registered Readers</h5>
            <p class="text-muted small mb-0">All readers registered in the database.</p>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3">#</th>
                        <th class="py-3">Full Name</th>
                        <th class="py-3">Email</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var reader in Model)
                        {
                            <tr>
                                <td class="ps-4">@rowNumber</td>
                                <td class="fw-semibold">@reader.FullName</td>
                                <td>@reader.Email</td>
                            </tr>
                            rowNumber++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <div class="display-4 mb-3">📚</div>
                                <h5 class="fw-bold">No readers yet</h5>
                                <p class="text-muted mb-0">Click "+ New Reader" to register a reader.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-0 p-4">
            <span class="text-muted small">Showing @Model.Count() reader(s)</span>
        </div>
    </div>
</div>